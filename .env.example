# Application URL used by NextAuth (required for local development)
NEXTAUTH_URL=http://localhost:3000

# Random secret for signing sessions (required in production)
# Generate with: openssl rand -base64 32
# If this is missing locally, NextAuth mints a new key on each reload and
# existing session cookies fail to decrypt (JWT_SESSION_ERROR / signed out).
NEXTAUTH_SECRET=replace-with-a-random-secret

# MongoDB connection (required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=assettags
